<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <!-- x64: the probe's Blender-parity tests compare float32 bits; the 32-bit .NET Framework host evaluates float in x87
         extended precision and lands an ulp or two off, where every real host (Unity's 64-bit Mono, the drill) is SSE -->
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HumankindAssetFramework.Tests</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- these tests exercise the PURE registry/parse/match logic only (no live-game reflection). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    <None Include="eigen_inverses.txt" CopyToOutputDirectory="PreserveNewest" />
</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HumankindAssetFramework.csproj" />
    <!-- Pure GLB core: production compiles it in the Unity editor assembly; tests compile the same source with
         UNITY_EDITOR absent, so the menu wrapper is excluded and the binary transformation remains testable. -->
    <Compile Include="..\editor\GlbDisconnectedParts.cs" Link="GlbDisconnectedParts.cs" />
    <Compile Include="..\editor\GlbDisconnectedParts.Compact.cs" Link="GlbDisconnectedParts.Compact.cs" />
    <!-- Pure editor decision kernels (extraction freshness, natural ordering) — same pattern. -->
    <Compile Include="..\editor\EditorRules.cs" Link="EditorRules.cs" />
    <!-- The multi-mesh split's estimator + BSP partition (2026-09-14): the quad ceiling that the Bremen depends on. -->
    <Compile Include="..\editor\QuadEstimate.cs" Link="QuadEstimate.cs" />
    <!-- The registry source's write, checked by what it displaced (review of PR #100): driven against real files. -->
    <Compile Include="..\editor\CheckedReplace.cs" Link="CheckedReplace.cs" />
    <!-- The in-memory model and the GLB reader (2026-09-30, step 1 of replacing Blender): pure C#, driven against synthetic files. -->
    <Compile Include="..\editor\HafModel.cs" Link="HafModel.cs" />
    <Compile Include="..\editor\GlbReader.cs" Link="GlbReader.cs" />
    <Compile Include="..\editor\HafTransforms.cs" Link="HafTransforms.cs" />
    <Compile Include="..\editor\GlbWriter.cs" Link="GlbWriter.cs" />
    <Compile Include="..\editor\HafModelDiff.cs" Link="HafModelDiff.cs" />
    <Compile Include="..\editor\BlenderNames.cs" Link="BlenderNames.cs" />
    <Compile Include="..\editor\VehicleProbe.cs" Link="VehicleProbe.cs" />
    <Compile Include="..\editor\VehicleProbe.Visibility.cs" Link="VehicleProbe.Visibility.cs" />
    <Compile Include="..\editor\VehicleProbe.Islands.cs" Link="VehicleProbe.Islands.cs" />
    <Compile Include="..\editor\VehicleProbe.InsideOut.cs" Link="VehicleProbe.InsideOut.cs" />
    <Compile Include="..\editor\VehicleProbe.BlenderWorld.cs" Link="VehicleProbe.BlenderWorld.cs" />
    <Compile Include="..\editor\VehicleProbe.BlenderSkin.cs" Link="VehicleProbe.BlenderSkin.cs" />
    <Compile Include="..\editor\VehicleProbe.CustomNormals.cs" Link="VehicleProbe.CustomNormals.cs" />
    <Compile Include="..\editor\VehicleProbe.Merge.cs" Link="VehicleProbe.Merge.cs" />
    <Compile Include="..\editor\VehicleProbe.BlenderArmature.cs" Link="VehicleProbe.BlenderArmature.cs" />
    <Compile Include="..\editor\HafUnityFrame.cs" Link="HafUnityFrame.cs" />
    <Compile Include="..\editor\BlenderMesh.cs" Link="BlenderMesh.cs" />
    <Compile Include="..\editor\BMesh.cs" Link="BMesh.cs" />
    <Compile Include="..\editor\BlenderColor.cs" Link="BlenderColor.cs" />
    <Compile Include="..\editor\BlenderTrig.cs" Link="BlenderTrig.cs" />
    <Compile Include="..\editor\BlenderDecimate.cs" Link="BlenderDecimate.cs" />
    <Compile Include="..\editor\BlenderReduce.cs" Link="BlenderReduce.cs" />
    <Compile Include="..\editor\BlenderExport.cs" Link="BlenderExport.cs" />
    <Compile Include="..\editor\BlenderExportTree.cs" Link="BlenderExportTree.cs" />
    <Compile Include="..\editor\BlenderEigen.cs" Link="BlenderEigen.cs" />
    <Compile Include="..\editor\BlenderPrep.cs" Link="BlenderPrep.cs" />
    <Compile Include="..\editor\BlenderPosedState.cs" Link="BlenderPosedState.cs" />
    <Compile Include="..\editor\BlenderDeploy.cs" Link="BlenderDeploy.cs" />
    <Compile Include="..\editor\BlenderFCurve.cs" Link="BlenderFCurve.cs" />
    <Compile Include="..\editor\VehicleProbe.BlenderPose.cs" Link="VehicleProbe.BlenderPose.cs" />
  </ItemGroup>

  <!-- compile-time references the TEST code uses directly -->
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule"><HintPath>..\References\UnityEngine.CoreModule.dll</HintPath></Reference>
    <!-- Plugin derives from BaseUnityPlugin : MonoBehaviour, so touching ANY static on it needs the base-type chain
         resolvable — even a pure static helper like Plugin.Poll. Added 2026-08-23 with PollIsolationTests. -->
    <Reference Include="UnityEngine"><HintPath>..\References\UnityEngine.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>..\References\BepInEx.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>..\References\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>..\References\0Harmony.dll</HintPath></Reference>   <!-- shared-seam census tests patch a dummy method with two real Harmony instances -->
  </ItemGroup>

  <!-- The plugin marks its refs Private=false (not copied), so mirror ALL of them into the test bin
       or the runtime can't resolve the plugin assembly's dependencies. -->
  <ItemGroup>
    <None Include="..\References\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
